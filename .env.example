# =============================================================================
# TerraSentinel Environment Variables
#
# Local setup:
#   1. Copy this file to `.env`  (required for `npx prisma migrate deploy`)
#   2. Copy this file to `.env.local` for Next.js dev (or use `.env` for both)
#   3. Replace placeholder values with your real credentials
#
# Vercel: set the same variables in Project → Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Database (server-side only — do NOT use NEXT_PUBLIC_ prefix)
# Required for Prisma and /api/save-user. prisma generate does not connect
# to the database, but the app needs this at runtime for user persistence.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/terrasentinel?schema=public

# -----------------------------------------------------------------------------
# Firebase (client-side — NEXT_PUBLIC_ prefix required)
# Get these from Firebase Console → Project Settings → Your apps → Web app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# OpenWeatherMap (client-side — NEXT_PUBLIC_ prefix required)
# Get a free API key from: https://openweathermap.org/api
# Used for rainfall data in flood analytics.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key

# -----------------------------------------------------------------------------
# Node environment (usually set automatically by Vercel / Next.js)
# -----------------------------------------------------------------------------
# NODE_ENV=development
